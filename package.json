{
  "name": "dsh-side-seat",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Ask this session a question without putting the answer into it.",
  "license": "MIT",
  "author": "ChenZongYang",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-management",
    "side-channel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-side-seat.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-side-seat/issues"
  },
  "homepage": "https://github.com/OWNER/dsh-side-seat#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/core.test.mjs && node test/integration.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
